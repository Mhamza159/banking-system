          "name": "1. Register Customer (Auto-opens Savings Account)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate random email to avoid conflicts",
                  "const randomNum = Math.floor(Math.random() * 100000);",
                  "pm.environment.set('temp_email', `customer_${randomNum}@banking.local`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "    console.log('Saved token:', json.data.token);",
                  "}",
                  "if (json.data && json.data.account) {",
                  "    pm.collectionVariables.set('accountId', json.data.account.id);",
                  "    console.log('Saved accountId:', json.data.account.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
