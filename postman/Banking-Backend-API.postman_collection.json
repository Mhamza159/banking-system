    {
      "name": "04 - ACID Transfers & Idempotency (Phase 5)",
      "item": [
        {
          "name": "0. Register Receiver Customer (User B) [Auto-saves receiverAccountId]",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomNum = Math.floor(Math.random() * 100000);",
                  "pm.environment.set('receiver_email', `receiver_${randomNum}@banking.local`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.account) {",
                  "    pm.collectionVariables.set('receiverAccountId', json.data.account.id);",
                  "    console.log('Saved receiverAccountId:', json.data.account.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Receiver User B\",\n  \"email\": \"{{receiver_email}}\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "1. Atomic Money Transfer ($100.00 = 10,000 cents)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const key = 'idemp-' + Date.now();",
                  "pm.collectionVariables.set('idempotencyKey', key);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.transaction) {",
                  "    pm.collectionVariables.set('transactionId', json.data.transaction.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderAccountId\": \"{{accountId}}\",\n  \"receiverAccountId\": \"{{receiverAccountId}}\",\n  \"amountInCents\": 10000,\n  \"description\": \"Consulting services payment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "transfer"]
            }
          }
        },
        {
          "name": "2. Duplicate Transfer with Same Idempotency-Key (Cached 200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is cached receipt', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.cached).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderAccountId\": \"{{accountId}}\",\n  \"receiverAccountId\": \"{{receiverAccountId}}\",\n  \"amountInCents\": 10000,\n  \"description\": \"Consulting services payment\"\n}"
